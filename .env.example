# OpenAI (Responses API supported)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional allow-list. When set, browser requests are limited to these models.
OPENAI_MODELS=gpt-5.6-terra,gpt-5.6,gpt-5.6-sol,gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local OpenAI-compatible provider. Configure it explicitly so the
# backend never accepts a provider URL from a browser request.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# LOCAL_LLM_MODEL=llama3.1
# LOCAL_LLM_MODELS=llama3.1
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_SUPPORTS_RESPONSES=false

# Optional named custom OpenAI-compatible provider.
# CUSTOM_LLM_BASE_URL=https://provider.example/v1
# CUSTOM_LLM_MODEL=
# CUSTOM_LLM_MODELS=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_SUPPORTS_RESPONSES=false

# Server safeguards
# PORT=3000
# HOST=127.0.0.1
# LIVECALC_AI_TIMEOUT_MS=120000
# LIVECALC_MAX_REQUEST_BYTES=1048576
# LIVECALC_RATE_LIMIT=60
# LIVECALC_RATE_WINDOW_MS=60000
# LIVECALC_ALLOWED_ORIGINS=https://your-livecalc.example
